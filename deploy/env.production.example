# Prism — Production Environment Configuration
# Copy to .env and fill in your values before deploying.

# ── Required ─────────────────────────────────────────────────────────

# Anthropic API key for Claude (analysis + briefing generation)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── External APIs (optional but recommended) ─────────────────────────

# Brave Search API key for news discovery (empty = RSS-only mode)
BRAVE_API_KEY=

# Resend API key for email delivery (empty = briefings stored but not sent)
RESEND_API_KEY=

# Sender address for briefing emails
BRIEFING_FROM_EMAIL=briefing@yourdomain.com

# ── Database ─────────────────────────────────────────────────────────

# SQLite path (relative to /app inside the container)
DATABASE_URL=sqlite:///app/data/prism.db

# ── Discovery (D_AI) ────────────────────────────────────────────────

# How often to run discovery (hours)
DISCOVERY_INTERVAL_HOURS=2

# Max articles per discovery cycle before dedup
MAX_STORIES_PER_CYCLE=50

# Minimum trust score for sources to be included
MIN_SOURCE_TRUST_SCORE=0.5

# ── Analysis (A_AI) ─────────────────────────────────────────────────

# Max perspectives extracted per story cluster
MAX_PERSPECTIVES_PER_STORY=5

# Token budget for article snippets sent to Claude
MAX_INPUT_TOKENS=8000

# ── Personalization (P_AI) ──────────────────────────────────────────

# Default stories per briefing (free tier)
DEFAULT_BRIEFING_STORIES=10

# Max stories per briefing (pro tier)
MAX_BRIEFING_STORIES=25

# ── Briefing Schedule (W_AI) ────────────────────────────────────────

# Cron expression for daily briefing generation (UTC)
BRIEFING_SCHEDULE_CRON=0 7 * * *

# ── Monitoring ──────────────────────────────────────────────────────

# ntfy.sh topic for push alerts (empty = alerts disabled)
# Create a topic at https://ntfy.sh/ and paste the name here
NTFY_TOPIC=
